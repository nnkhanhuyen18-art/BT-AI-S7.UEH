    plt.imshow(img_display)
    plt.title("Ảnh để kiểm tra với Model đã cập nhật")
    plt.axis('off')


    plt.text(10, 30, f"Dự đoán: {predicted_label_updated}", color='red', fontsize=12,
             bbox=dict(facecolor='white', alpha=0.7))
    plt.show()

    print(f"\nPredicted Class (Updated Model): {predicted_label_updated}")
    print("Probabilities (Updated Model):")
    for i, prob in enumerate(probabilities_updated):
        print(f"  {class_labels[i]}: {prob:.4f}")

